# 1Fi Marketplace Client Environment Variables
# Leave blank for local Vite proxy to localhost:5000
# In production on Vercel or Render, set to your backend API URL (e.g., https://onefi-marketplace-api.onrender.com)
# Both API_URL (for Render Config) and VITE_API_URL (for Vercel) are fully supported.
API_URL=
VITE_API_URL=
